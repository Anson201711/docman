# ============================================
# DocMan Backend Dockerfile
# Supports standalone (single JAR) and distributed (multiple JARs) modes
# ============================================

# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /build

# Configure Maven to use Aliyun mirror
RUN mkdir -p /usr/share/maven/ref/conf && \
    echo '<?xml version="1.0" encoding="UTF-8"?><settings><mirrors><mirror><id>aliyun</id><name>Aliyun Maven</name><url>https://maven.aliyun.com/repository/public</url><mirrorOf>central</mirrorOf></mirror></mirrors></settings>' > /usr/share/maven/ref/conf/settings.xml

# Copy entire project (pom.xml is at root, modules are at docman-*/)
COPY . /build/

# Build arguments
ARG PROFILE=standalone

# Build the application
RUN mvn clean package -P${PROFILE} -DskipTests -B -s /usr/share/maven/ref/conf/settings.xml

# ============================================
# Stage 2: Runtime - Standalone Mode
# Single fat JAR containing all services
# ============================================
FROM eclipse-temurin:17-jre-jammy AS runtime-standalone

LABEL maintainer="DocMan Team"
LABEL description="DocMan Backend - Standalone Mode (All-in-One)"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy standalone fat JAR
COPY --from=builder /build/docman-standalone/target/*.jar /app/docman-standalone.jar

# Copy startup script
COPY docker/scripts/start-standalone.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8080

ENTRYPOINT ["/app/start.sh"]

# ============================================
# Stage 2: Runtime - Distributed Mode
# Multiple JARs, each service runs independently
# ============================================
FROM eclipse-temurin:17-jre-jammy AS runtime-distributed

LABEL maintainer="DocMan Team"
LABEL description="DocMan Backend - Distributed Mode (Multiple JARs)"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy all service JARs
COPY --from=builder /build/docman-gateway/target/*.jar /app/docman-gateway.jar
COPY --from=builder /build/docman-user/target/*.jar /app/docman-user.jar
COPY --from=builder /build/docman-document/target/*.jar /app/docman-document.jar
COPY --from=builder /build/docman-storage/target/*.jar /app/docman-storage.jar
COPY --from=builder /build/docman-search/target/*.jar /app/docman-search.jar
COPY --from=builder /build/docman-version/target/*.jar /app/docman-version.jar
COPY --from=builder /build/docman-classification/target/*.jar /app/docman-classification.jar
COPY --from=builder /build/docman-approval/target/*.jar /app/docman-approval.jar
COPY --from=builder /build/docman-subscription/target/*.jar /app/docman-subscription.jar
COPY --from=builder /build/docman-collaboration/target/*.jar /app/docman-collaboration.jar
COPY --from=builder /build/docman-cad/target/*.jar /app/docman-cad.jar
COPY --from=builder /build/docman-system/target/*.jar /app/docman-system.jar

# Copy service start script
COPY docker/scripts/start-service.sh /app/start.sh
RUN chmod +x /app/start.sh

EXPOSE 8080 8081 8082 8083 8084 8085 8086 8087 8088 8089 8090 8091

ENTRYPOINT ["/app/start.sh"]
