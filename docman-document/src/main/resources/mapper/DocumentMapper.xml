<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.docman.document.repository.DocumentRepository">

    <resultMap id="BaseResultMap" type="com.docman.document.entity.Document">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="content" property="content"/>
        <result column="file_type" property="fileType"/>
        <result column="size" property="size"/>
        <result column="folder_id" property="folderId"/>
        <result column="path" property="path"/>
        <result column="owner_id" property="ownerId"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="findByFolderId" resultMap="BaseResultMap">
        SELECT * FROM document
        WHERE folder_id = #{folderId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByOwnerId" resultMap="BaseResultMap">
        SELECT * FROM document
        WHERE owner_id = #{ownerId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByFolderIdAndOwnerId" resultMap="BaseResultMap">
        SELECT * FROM document
        WHERE folder_id = #{folderId}
        AND owner_id = #{ownerId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByNameAndFolderId" resultMap="BaseResultMap">
        SELECT * FROM document
        WHERE name = #{name}
        AND folder_id = #{folderId}
        AND deleted = 0
        LIMIT 1
    </select>

    <select id="findDeletedByOwnerId" resultMap="BaseResultMap">
        SELECT * FROM document
        WHERE owner_id = #{ownerId}
        AND deleted = 1
        ORDER BY update_time DESC
    </select>

</mapper>
