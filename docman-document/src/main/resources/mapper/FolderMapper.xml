<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.docman.document.repository.FolderRepository">

    <resultMap id="BaseResultMap" type="com.docman.document.entity.Folder">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="path" property="path"/>
        <result column="owner_id" property="ownerId"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT * FROM folder
        WHERE parent_id = #{parentId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByOwnerId" resultMap="BaseResultMap">
        SELECT * FROM folder
        WHERE owner_id = #{ownerId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByParentIdAndOwnerId" resultMap="BaseResultMap">
        SELECT * FROM folder
        WHERE parent_id = #{parentId}
        AND owner_id = #{ownerId}
        AND deleted = 0
        ORDER BY sort_order, create_time DESC
    </select>

    <select id="findByNameAndParentId" resultMap="BaseResultMap">
        SELECT * FROM folder
        WHERE name = #{name}
        AND parent_id = #{parentId}
        AND deleted = 0
        LIMIT 1
    </select>

    <select id="findDeletedByOwnerId" resultMap="BaseResultMap">
        SELECT * FROM folder
        WHERE owner_id = #{ownerId}
        AND deleted = 1
        ORDER BY update_time DESC
    </select>

</mapper>
